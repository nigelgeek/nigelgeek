# GEMINI_API_KEY: Required for Gemini AI API calls.

# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Consultation email API (Vercel serverless function) ---
# Set these in the Vercel project's Environment Variables (not committed to git).
# SMTP_HOST: Your SMTP server hostname.
SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT: SMTP port (465 for SSL, 587 for STARTTLS).
SMTP_PORT="465"
# SMTP_SECURE: "true" for SSL (port 465), "false" for STARTTLS (port 587).
SMTP_SECURE="true"
# SMTP_USER: SMTP username (usually your email address).
SMTP_USER="hello@nigelgeek.com"
# SMTP_PASS: SMTP password.
SMTP_PASS="your-smtp-password"
# RECIPIENT_EMAIL: Where consultation requests are delivered.
RECIPIENT_EMAIL="hello@nigelgeek.com"
